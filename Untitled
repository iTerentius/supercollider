evice knobs CC 16..23
ccHi = 0x17;

defaultBtnNotes = (
    g1: 0x3A, g2: 0x3B, g3: 0x3C, g4: 0x3D,
    g5: 0x3E, g6: 0x3F, g7: 0x40, g8: 0x41
);

// --- shared state on ~ ---
~apcDG = ~apcDG ? IdentityDictionary.new;
~apcDG[\out] = ~apcDG[\out] ? nil;                           // MIDIOut to APC
~apcDG[\uid] = ~apcDG[\uid] ? nil;
~apcDG[\debug] = ~apcDG[\debug] ? false;
~apcDG[\btnNotes] = ~apcDG[\btnNotes] ? defaultBtnNotes;
~apcDG[\groupByBank] = ~apcDG[\groupByBank] ? Array.fill(maxBanks, 1);
~apcDG[\funcs] = ~apcDG[\funcs] ? IdentityDictionary.new;
~apcDG[\currentBank] = ~apcDG[\currentBank] ? 0;

// --- helpers ---
findAPCOut = {
    var outs, idx, out;
    outs = MIDIClient.destinations;
    idx  = outs.detectIndex { |ep| ep.notNil and: { ep.device == apcName } };
    out = if(idx.isNil) { nil } { MIDIOut.newByName(apcName, apcName) };
    out
};

sendIntroGeneric = {
    var bytes;
    bytes = Int8Array[0xF0, 0x47, 0x7F, 0x29, 0x60, 0x00, 0x04, 0x40, 0x00, 0x00, 0x00, 0xF7];
    ~apcDG[\out].tryPerform(\sysex, bytes);
};

ledOn  = { |note| ~apcDG[\out].tryPerform(\noteOn, 0, note, 1) };
ledOff = { |note| ~apcDG[\out].tryPerform(\noteOff, 0, note, 0) };

refreshLEDsForBank = { |bank|
    var g, notes;
    g = ~apcDG[\groupByBank].wrapAt(bank);
    notes = [
        ~apcDG[\btnNotes][\g1], ~apcDG[\btnNotes][\g2], ~apcDG[\btnNotes][\g3], ~apcDG[\btnNotes][\g4],
        ~apcDG[\btnNotes][\g5], ~apcDG[\btnNotes][\g6], ~apcDG[\btnNotes][\g7], ~apcDG[\btnNotes][\g8]
    ];
    notes.do { |n, i|
        if((i+1) == g) { ledOn.(n) } { ledOff.(n) };
    };
    if(~apcDG[\debug]) { ["[apcDG] led-refresh", \bank, bank, \group, g].postln };
};

// Parse keys like \b0_g7_d3
parseKey = { |key|
    var s, b, g, d;
    s = key.asString;
    b = s.findRegexp("b(\\d+)").tryPerform(\at, 1).tryPerform(\asInteger);
    g = s.findRegexp("g(\\d+)").tryPerform(\at, 1).tryPerform(\asInteger);
    d = s.findRegexp("d(\\d+)").tryPerform(\at, 1).tryPerform(\asInteger);
    if(b.isNil or: { g.isNil } or: { d.isNil }) { nil } { (bank: b, group: g, device: d) }
};

// Provide or wrap a binder to capture _g/_d device assigns
ensureWrappers = {
    var old;
    var validKey;

    validKey = { |p|
        var conds;
        conds = [
            p[\bank].notNil, p[\group].notNil, p[\device].notNil,
            p[\bank].isInteger, p[\group].isInteger, p[\device].isInteger,
            p[\bank] >= 0, p[\bank] < maxBanks,
            p[\group] >= 1, p[\group] <= maxGroups,
            p[\device] >= 1, p[\device] <= maxDevices
        ];
        conds.every { |c| c == true }
    };

    if(~apcBindParam.isKindOf(Function)) {
        old = ~apcBindParam;
        ~apcBindParam = { |key, func|
            var p, tag, handled, ok, res;
            p = parseKey.(key);
            handled = false;
            if(p.notNil) {
                ok = validKey.(p);
                if(ok) {
                    tag = "\\b%_g%_d%".format(p[\bank], p[\group], p[\device]).asSymbol;
                    ~apcDG[\funcs][tag] = func;
                    if(~apcDG[\debug]) { ["[apcDG bind]", tag].postln };
                    handled = true;
                }{
                    res = old.(key, func);
                    handled = res.notNil;   // <- changed from .asBoolean
                };
            }{
                res = old.(key, func);
                handled = res.notNil;       // <- changed from .asBoolean
            };
            handled
        };
    }{
        ~apcBindParam = { |key, func|
            var p, tag, handled, ok;
            p = parseKey.(key);
            handled = false;
            if(p.notNil) {
                ok = validKey.(p);
                if(ok) {
                    tag = "\\b%_g%_d%".format(p[\bank], p[\group], p[\device]).asSymbol;
                    ~apcDG[\funcs][tag] = func;
                    if(~apcDG[\debug]) { ["[apcDG bind]", tag].postln };
                    handled = true;
                };
            };
            handled
        };
    };
};

// MIDIdefs
installNoteDef = {
    if(~apcDG[\noteDef].notNil) { ~apcDG[\noteDef].free };
    ~apcDG[\noteDef] = MIDIdef.noteOn(\apc_dg_buttons8, { |vel, note, chan, src|
        var bank, notes, groupIdx, g1, g2, g3, g4, g5, g6, g7, g8;
        bank = ~apcDG[\currentBank].clip(0, maxBanks-1);
        notes = ~apcDG[\btnNotes];
        g1 = notes[\g1]; g2 = notes[\g2]; g3 = notes[\g3]; g4 = notes[\g4];
        g5 = notes[\g5]; g6 = notes[\g6]; g7 = notes[\g7]; g8 = notes[\g8];

        if(~apcDG[\debug]) { ["[apcDG note]", \note, note, \vel, vel].postln };

        if(vel > 0) {
            groupIdx = case
            { note == g1 } { 1 }
            { note == g2 } { 2 }
            { note == g3 } { 3 }
            { note == g4 } { 4 }
            { note == g5 } { 5 }
            { note == g6 } { 6 }
            { note == g7 } { 7 }
            { note == g8 } { 8 }
            { nil };

            if(groupIdx.notNil) {
                ~apcDG[\groupByBank].put(bank, groupIdx);
                refreshLEDsForBank.(bank);
                if(~apcDG[\debug]) { ["[apcDG group set]", \bank, bank, \group, groupIdx].postln };
            };
        };
    });
};

installCCDef = {
    if(~apcDG[\ccDef].notNil) { ~apcDG[\ccDef].free };
    ~apcDG[\ccDef] = MIDIdef.cc(\apc_dg_cc8, { |val, num, chan, src|
        var bank, group, device, tag, func, norm;
        if(num >= ccLo and: { num <= ccHi }) {
            bank = chan.clip(0, maxBanks-1);
            ~apcDG[\currentBank] = bank;
            group = ~apcDG[\groupByBank].wrapAt(bank);
            device = (num - ccLo + 1).clip(1, maxDevices);
            tag = "\\b%_g%_d%".format(bank, group, device).asSymbol;
            func = ~apcDG[\funcs][tag];

            if(~apcDG[\debug]) { ["[apcDG cc]", \bank, bank, \group, group, \d, device, \val, val].postln };

            if(func.notNil) {
                norm = val.linlin(0, 127, 0.0, 1.0).clip(0.0, 1.0);
                func.value(norm, val, num, chan, bank, group, device);
            };
        };
    });
};

// --- public helpers ---
~apcDGSetGroup = { |bank, group|
    var b, g;
    b = bank.clip(0, maxBanks-1);
    g = group.clip(1, maxGroups);
    ~apcDG[\groupByBank][b] = g;
    refreshLEDsForBank.(b);
};

~apcDGGetGroup = { |bank|
    var b;
    b = bank.clip(0, maxBanks-1);
    ~apcDG[\groupByBank].wrapAt(b)
};

~apcDGRefresh = {
    maxBanks.do { |i| refreshLEDsForBank.(i) };
    "[apcDG refreshed]".postln;
};

// --- arming ---
~apcDGArm = {
    var out, didIntro;
    ensureWrappers.();

    out = ~apcDG[\out];
    if(out.isNil) {
        out = findAPCOut.();
        ~apcDG[\out] = out;
    };

    if(out.notNil) {
        sendIntroGeneric.();
        didIntro = true;
    }{
        didIntro = false;
    };

    installNoteDef.();
    installCCDef.();

    maxBanks.do { |b| refreshLEDsForBank.(b) };
    if(~apcDG[\debug]) { ["[apcDG armed]", \outReady, out.notNil, \introSent, didIntro].postln };
    "[apcDG armed]".postln;
};

// arm immediately on include eval
~apcDGArm.();

)

